{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Exam Specification Schema v1406",
  "type": "object",
  "required": [
    "examSetCode",
    "examYear",
    "experimentalGroup",
    "organizer",
    "subjects",
    "coefficientRatios",
    "verificationStatus"
  ],
  "properties": {
    "examSetCode": {
      "type": "string",
      "description": "Exam set code, e.g. '2162' for Management"
    },
    "examYear": {
      "type": "integer",
      "enum": [1405, 1406],
      "description": "Exam year (1405 or 1406)"
    },
    "experimentalGroup": {
      "type": "string",
      "description": "Experimental group, e.g. 'علوم humaines'"
    },
    "organizer": {
      "type": "string",
      "description": "Exam organizer, e.g. 'سازمان سنجش آموزش کشور'"
    },
    "verificationStatus": {
      "type": "string",
      "enum": ["official_verified", "reported", "needs_check"],
      "description": "Verification status of the exam structure"
    },
    "coefficientRatios": {
      "type": "object",
      "properties": {
        "specializationCoefficient": {
          "type": "integer",
          "enum": [4, 5],
          "description": "Coefficient for specialized courses (4 for 1403-1404, 5 for 1405+)"
        },
        "languageCoefficient": {
          "type": "integer",
          "enum": [1],
          "description": "Coefficient for language section"
        },
        "aptitudeCoefficient": {
          "type": "integer",
          "enum": [1, null],
          "description": "Coefficient for aptitude test (null for 1405+)"
        }
      },
      "required": ["specializationCoefficient", "languageCoefficient", "aptitudeCoefficient"]
    },
    "questionCounts": {
      "type": "object",
      "properties": {
        "specializationMin": {
          "type": "integer",
          "description": "Minimum specialized questions"
        },
        "specializationMax": {
          "type": "integer",
          "description": "Maximum specialized questions"
        },
        "languageCount": {
          "type": "integer",
          "description": "Number of language questions"
        }
      },
      "required": ["specializationMin", "specializationMax", "languageCount"]
    },
    "durationMinutes": {
      "type": "object",
      "properties": {
        "specialization": {
          "type": ["integer", "null"],
          "description": "Specialized exam duration in minutes (null if not applicable)"
        },
        "language": {
          "type": ["integer", "null"],
          "description": "Language exam duration in minutes"
        }
      },
      "required": ["specialization", "language"]
    },
    "negativeMarkingRatio": {
      "type": "number",
      "description": "Ratio of negative marking (e.g. 1/3)"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "level", "coefficient"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable subject identifier"
          },
          "title": {
            "type": "string",
            "description": "Subject title in Persian"
          },
          "level": {
            "type": "string",
            "enum": ["کارشناسی", "کارشناسی ارشد", "عمومی"],
            "description": "Educational level"
          },
          "coefficient": {
            "type": "number",
            "description": "Subject coefficient in the exam"
          }
        }
      },
      "description": "List of subjects with their coefficients"
    },
    "subGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "code", "title", "fields", "verification"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Subject group identifier"
          },
          "code": {
            "type": "string",
            "description": "Exam subgroup code in the scorecard"
          },
          "title": {
            "type": "string",
            "description": "Group title in Persian"
          },
          "fields": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Fields/sub-areas within the subgroup"
          },
          "verification": {
            "type": "string",
            "enum": ["official_verified", "reported", "needs_check"],
            "description": "Verification status of this subgroup"
          }
        }
      },
      "description": "Exam subgroups with their codes and fields"
    },
    "knowledgeGraphSpec": {
      "type": "object",
      "description": "Reference to knowledge graph structure mapping courses → topics → concepts → skills"
    },
    "sourceRegistry": {
      "type": "object",
      "properties": {
        "officialDocuments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "date", "version", "sha256"],
            "properties": {
              "title": { "type": "string" },
              "date": { "type": "string", "format": "date" },
              "version": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "academicReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "authors", "journal", "year", "sha256"],
            "properties": {
              "title": { "type": "string" },
              "authors": {
                "type": "array",
                "items": { "type": "string" }
              },
              "journal": { "type": "string" },
              "year": { "type": "integer" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    }
  }
}