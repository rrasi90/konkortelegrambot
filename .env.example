# Supabase (پروژه خودتان را بسازید و مقادیر را از Settings > API بردارید)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# کلید امضای توکن نشست کاربران (مقداری تصادفی و طولانی)
SESSION_SECRET=change-me-to-a-long-random-string

# توکن ربات تلگرام (برای اعتبارسنجی initData مینی‌اپ)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# فقط برای محیط توسعه/دموی محلی؛ در تولید false بماند
ALLOW_DEMO_AUTH=true
