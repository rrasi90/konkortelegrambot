# Local reference only. Never put real credentials in this file.
# Telegram BotFather token: configure as a Cloudflare Worker secret, not a VITE_ variable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Supabase project URL and service-role key must only be used server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public mini-app origin used for CORS allowlisting in a deployed environment.
APP_ORIGIN=http://localhost:5173
