{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --outDir dist",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "extract:konkor": "tsx scripts/extractAndSyncKonkorSources.ts",
    "bot": "node scripts/telegram-bot-service.mjs",
    "build:worker": "npm run --prefix apps/worker build",
    "validate:content": "node scripts/validate-content.mjs --all",
    "test": "vitest run",
    "validate:phase1": "node scripts/validate-phase-1-foundation.mjs",
    "audit:client-bundle": "node --import tsx scripts/audit-client-bundle.ts",
    "audit:miniapp": "node --import tsx scripts/audit-client-bundle.ts apps/miniapp",
    "audit:offline": "node --import tsx scripts/audit-client-bundle.ts tools/offline",
    "dev:miniapp": "node --import tsx scripts/dev-server.mjs",
    "build:legacy": "vite build --mode legacy",
    "test:db": "node scripts/db-test-embedded.mjs",
    "build:offline": "node scripts/build-ael-offline.mjs",
    "validate:learning": "node --import tsx scripts/validate-learning-courses.ts && node scripts/verify-source-audit.mjs && node scripts/extract-learning-recurrence.mjs 1405 --check && node scripts/build-question-index.mjs --check",
    "import:registry": "tsx scripts/import-registry.ts",
    "ael:pdf:scan": "node scripts/ael-pdf-scan.mjs",
    "ael:pdf:ingest": "node scripts/ael-pdf-ingest.mjs",
    "ael:pdf:ocr": "node scripts/ael-pdf-ocr.mjs",
    "ael:pdf:convert": "node scripts/convert-pdf-md.mjs",
    "ael:pdf:check": "node scripts/ael-pdf-guard.mjs",
    "audit:exam-bank": "node --import tsx scripts/audit-exam-bank.mts",
    "evidence:exam-keys": "node --import tsx scripts/build-exam-key-evidence.mts",
    "import:exam-markdown": "node --import tsx scripts/import-exam-markdown.mts",
    "ael:exam:analyze": "node scripts/ael-exam-analyze.mjs --run-id structural-20261106f",
    "ael:exam:recovery": "python -I scripts/ael-key-text-recovery.py",
    "ael:exam:merge-keys": "python -I scripts/ael-key-merge-recovered.py",
    "ael:exam:dedup": "node scripts/ael-question-dedup.mjs",
    "build:miniapp": "vite build --mode miniapp",
    "sync:miniapp": "node scripts/sync-miniapp-build.mjs",
    "check:production": "node scripts/preflight-production.mjs",
    "v2:ledger": "node scripts/v2/ledger.mjs",
    "v2:verify": "node scripts/v2/verify-ledger.mjs",
    "v2:summary": "node scripts/v2/ledger.mjs summary",
    "v2:reading-notes": "node scripts/v2/reading-notes-check.mjs",
    "exam:inventory": "node --import tsx scripts/exam-inventory.mts",
    "import:exam-persian": "node --import tsx scripts/import-exam-persian.mts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cytoscape": "^3.21.9",
    "@types/katex": "^0.16.8",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "cytoscape": "^3.34.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "katex": "^0.19.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "^1.65.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.5.438",
    "tailwindcss": "^4.3.3",
    "ts-fsrs": "6.0.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
